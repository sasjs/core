{
  "noTrailingSpaces": true,
  "noEncodedPasswords": true,
  "hasDoxygenHeader": true,
  "hasMacroNameInMend": true,
  "hasMacroParentheses": true,
  "lineEndings": "lf",
  "noGremlins": true,
  "noNestedMacros": true,
  "noSpacesInFileNames": true,
  "maxLineLength": 80,
  "lowerCaseFileNames": true,
  "noTabs": true,
  "indentationMultiple": 2,
  "severityLevel": {
    "hasDoxygenHeader": "error",
    "hasMacroNameInMend": "error",
    "hasMacroParentheses": "error",
    "indentationMultiple": "error",
    "lineEndings": "error",
    "lowerCaseFileNames": "error",
    "maxLineLength": "error",
    "minMacroNameLength": "error",
    "noEncodedPasswords": "error",
    "noGremlins": "error",
    "noNestedCommentsInHeader": "error",
    "noSpacesInFileNames": "error",
    "noTabs": "error",
    "noTrailingSpaces": "error",
    "noUndeclaredMacros": "error",
    "noUnusedMacros": "error",
    "strictMacroDefinition": "error",
    "noBannedStrings": "error",
    "noSingleAsteriskComments": "error",
    "noUnusedLibnames": "error",
    "hasRequiredMacroOptions": "error"
  },
  "ignoreList": [
    "all.sas"
  ]
}
