{
  "name": "@sasjs/core",
  "description": "Production-quality MIT-licensed SAS macro library (mf_*, mp_*, mm* macros) for SAS 9 and Viya application development",
  "license": "MIT",
  "keywords": [
    "SAS",
    "Viya",
    "SASjs",
    "sas-macros",
    "sas-macro-library",
    "sas9",
    "sas-viya",
    "datastep",
    "etl",
    "sasjs-cli"
  ],
  "author": "Allan Bowe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/core.git"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/sasjs/core/issues"
  },
  "homepage": "https://core.sasjs.io",
  "scripts": {
    "build": "npx @sasjs/cli cbd -t server",
    "docs": "npx @sasjs/cli doc -t docsonly && ./sasjs/utils/build.sh",
    "test": "npx @sasjs/cli test -t server",
    "lint": "npx @sasjs/cli lint",
    "prepare": "git rev-parse --git-dir && git config core.hooksPath ./.git-hooks || true"
  },
  "maintainers": [
    "https://sasapps.io"
  ]
}